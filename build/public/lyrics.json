  },
  {
    "start": 155.76,
    "end": 157.58,
    "text": "錯誤不是終點"
  },
  {
    "start": 157.58,
    "end": 159.2,
    "text": "是下一次的火"
  },
  {
    "start": 159.2,
    "end": 161.08,
