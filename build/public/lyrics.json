[
  {
    "start": 16.5,
    "end": 19.12,
    "text": "一頁一頁翻"
  },
  {
    "start": 19.12,
    "end": 21.38,
    "text": "改到天快亮"
  },
  {
    "start": 21.38,
    "end": 23.12,
    "text": "白板上的箭頭"
  },
  {
    "start": 23.12,
    "end": 25.36,
    "text": "畫得像河床"
  },
  {
    "start": 25.36,
    "end": 27.08,
    "text": "需求一來再來"
  },
  {
    "start": 27.08,
    "end": 29.0,
    "text": "像浪拍船艙"
  },
  {
    "start": 29.0,
    "end": 30.86,
    "text": "我把每個卡點"
  },
  {
    "start": 30.86,
    "end": 32.42,
    "text": "都釘進心臟"
  },
  {
    "start": 32.42,
    "end": 33.82,
    "text": "你說要更穩"
  },
  {
    "start": 33.82,
    "end": 35.72,
    "text": "我就把它加寬"
  },
  {
    "start": 35.72,
    "end": 37.5,
    "text": "你說要更快"
  },
  {
    "start": 37.5,
    "end": 39.4,
    "text": "我就把它拉直"
  },
  {
    "start": 40.5,
    "end": 41.28,
    "text": "反覆試"
  },
  {
    "start": 41.28,
    "end": 42.06,
    "text": "反覆磨"
  },
  {
    "start": 42.06,
    "end": 43.9,
    "text": "每個字都要對"
  },
  {
    "start": 43.9,
    "end": 47.8,
    "text": "每一步都不退"
  },
  {
    "start": 47.8,
    "end": 49.051,
    "text": "燈還亮"
  },
  {
    "start": 49.051,
    "end": 50.303,
    "text": "人還在"
  },
  {
    "start": 50.303,
    "end": 52.628,
    "text": "手上那支筆"
  },
  {
    "start": 52.628,
    "end": 54.56,
    "text": "寫出下一排"
  },
  {
    "start": 56.0,
    "end": 57.522,
    "text": "舟神課程"
  },
  {
    "start": 57.522,
    "end": 59.55,
    "text": "一關一關闖"
  },
  {
    "start": 59.55,
    "end": 60.9,
    "text": "舟神課程"
  },
  {
    "start": 60.9,
    "end": 63.43,
    "text": "我帶你去遠方"
  },
  {
    "start": 63.43,
    "end": 64.9,
    "text": "舟神課程"
  },
  {
    "start": 64.9,
    "end": 66.64,
    "text": "不怕風浪"
  },
  {
    "start": 66.64,
    "end": 68.14,
    "text": "舟神課程"
  },
  {
    "start": 68.14,
    "end": 69.7,
    "text": "一路都發光"
  },
  {
    "start": 69.7,
    "end": 74.812,
    "text": "(舟神課程)"
  },
  {
    "start": 74.812,
    "end": 79.16,
    "text": "(一路都發光)"
  },
  {
    "start": 82.02,
    "end": 83.76,
    "text": "樣板先跑過"
  },
  {
    "start": 83.76,
    "end": 85.46,
    "text": "錯了就重來"
  },
  {
    "start": 85.46,
    "end": 87.22,
    "text": "同一段流程"
  },
  {
    "start": 87.22,
    "end": 88.9,
    "text": "磨到很自然"
  },
  {
    "start": 88.9,
    "end": 90.44,
    "text": "有人想省步"
  },
  {
    "start": 90.44,
    "end": 92.38,
    "text": "有人想更滿"
  },
  {
    "start": 92.38,
    "end": 94.04,
    "text": "我把節奏分好"
  },
  {
    "start": 94.04,
    "end": 95.24,
    "text": "讓每步都能站"
  },
  {
    "start": 95.24,
    "end": 96.936,
    "text": "測試那一夜"
  },
  {
    "start": 96.936,
    "end": 98.548,
    "text": "表格排成山"
  },
  {
    "start": 98.548,
    "end": 100.364,
    "text": "紅字像雨點"
  },
  {
    "start": 100.364,
    "end": 102.136,
    "text": "我也沒喊慌"
  },
  {
    "start": 102.136,
    "end": 103.768,
    "text": "因為我知道"
  },
  {
    "start": 103.768,
    "end": 105.63,
    "text": "慢一點也無妨"
  },
  {
    "start": 105.63,
    "end": 108.412,
    "text": "把每個細節"
  },
  {
    "start": 108.412,
    "end": 111.1,
    "text": "都做成答案"
